APP_NAME="Sistem Pemberkasan"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sistem_pemberkasan
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

# JWT Configuration. JWT_SECRET wajib terisi, kalau kosong login gagal dengan Secret is not set
JWT_SECRET=2ded0e67ad5279a9c6ad4d467f8371c3a6beb13b12517466e0bbfb5a906e8786
JWT_TTL=1440
JWT_REFRESH_TTL=20160
JWT_BLACKLIST_ENABLED=true

# File Upload. Satuan KB, maks 20480
MAX_FILE_SIZE=20480
ALLOWED_MIMES=pdf

# Seeder admin. Kosong berarti pakai password dev bawaan
SEED_ADMIN_EMAIL=admin@agrotek.com
SEED_ADMIN_PASSWORD=Agr0t3knologi123

# Khusus container MySQL Docker saat inisialisasi awal. Kosong di dev lokal
DB_ROOT_PASSWORD=

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="noreply@pemberkasan.test"
MAIL_FROM_NAME="${APP_NAME}"
