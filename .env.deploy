# ─────────────────────────────────────────────────────────────────────────────
# .env.deploy — nilai environment KHUSUS Docker
#
# CARA PAKAI:
#   cp .env.deploy .env        (jika belum ada .env)
#   atau gabungkan: `cat .env.deploy >> .env` untuk menimpa nilai lokal.
#
# Semua key di sini WAJIB menang atas nilai development di .env,
# karena di dalam container host database bukan 127.0.0.1 melainkan `db`.
#
# JANGAN commit file yang berisi password asli. Untuk .env final di server,
# isi password langsung di server, bukan di repo.
# ─────────────────────────────────────────────────────────────────────────────

# ── Aplikasi ─────────────────────────────────────────────────────────────────
APP_ENV=production
APP_DEBUG=false
APP_URL=https://domain-anda.ac.id
LOG_CHANNEL=stderr
LOG_LEVEL=error

# ── Koneksi host di jaringan Docker (BUKAN 127.0.0.1) ───────────────────────
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
REDIS_HOST=redis
REDIS_PORT=6379

# ── Driver yang wajib beda di dalam container ───────────────────────────────
# File session di container akan hilang saat restart → pakai Redis.
SESSION_DRIVER=redis
CACHE_DRIVER=redis
QUEUE_CONNECTION=redis
BROADCAST_DRIVER=log

# ── Cookie & session aman untuk HTTPS ───────────────────────────────────────
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
SESSION_LIFETIME=720

# ── Penyimpanan dokumen: volume Docker, bukan public/ ───────────────────────
FILESYSTEM_DISK=local
DOCUMENTS_DISK=local

# ── Batas upload: harus sinkron dengan docker-compose.yml ───────────────────
# MAX_FILE_SIZE (KB) <= upload_max_filesize (20M) <= client_max_body_size (24M)
MAX_FILE_SIZE=20480
ALLOWED_MIMES=pdf

# ── Nilai rahasia: ISI DI SERVER, JANGAN DI SINI ────────────────────────────
# APP_KEY   → php artisan key:generate --show
# JWT_SECRET → openssl rand -hex 32
# DB_PASSWORD, DB_ROOT_PASSWORD, SEED_ADMIN_PASSWORD
#
# Letakkan di file .env server saja. Entrypoint akan menolak start bila kosong.
